{
  "name": "menu-ai",
  "version": "1.1.0",
  "description": "Menu AI",
  "main": "main.js",
  "author": "Menu AI",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.menuai.desktop",
    "productName": "Menu AI",
    "files": ["main.js", "preload.js", "keys.js", "index.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MenuAI-Setup-${version}.exe"
    },
    "publish": [
      { "provider": "github", "owner": "digitalendri", "repo": "menu-ai-pc", "releaseType": "release" }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
