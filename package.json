{
  "name": "menu-ai",
  "version": "1.0.0",
  "description": "Menu AI",
  "main": "main.js",
  "author": "Menu AI",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.menuai.desktop",
    "productName": "Menu AI",
    "files": ["main.js", "preload.js", "index.html"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MenuAI-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
